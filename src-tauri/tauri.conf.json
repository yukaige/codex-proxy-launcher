{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 代理启动器",
  "version": "0.3.2",
  "identifier": "com.codexproxy.launcher",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex 代理启动器",
        "width": 1120,
        "height": 820,
        "minWidth": 640,
        "minHeight": 680,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "为 Codex/ChatGPT 配置代理并启动",
    "longDescription": "同时配置 Chromium 和 Codex app-server 代理的 macOS/Windows 启动工具。",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
