{
  "name": "codex-proxy-launcher",
  "version": "0.2.0",
  "private": true,
  "description": "通过 Chromium 代理参数和环境变量启动 macOS Codex/ChatGPT 桌面客户端。",
  "author": "yukaige",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:renderer": "vite build",
    "build": "tauri build --no-bundle",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dist:mac": "tauri build --bundles app,dmg --target aarch64-apple-darwin",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
